{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpv.example.invalid/contracts/race-event/v1/stream-envelope.schema.json",
  "title": "Race Data Hub Stream Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "hubEpoch", "eventSessionId", "streamSequence", "deliveredAt", "data"],
  "properties": {
    "type": {
      "enum": ["snapshot", "status", "warning", "heartbeat", "reset", "announcement", "announcement-clear"]
    },
    "hubEpoch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "eventSessionId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        { "type": "null" }
      ]
    },
    "streamSequence": {
      "type": "integer",
      "minimum": 1
    },
    "snapshotSequence": {
      "type": "integer",
      "minimum": 1
    },
    "deliveredAt": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "oneOf": [
        {
          "$ref": "snapshot.schema.json"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["connection", "source", "event", "quality"],
          "properties": {
            "connection": { "enum": ["disabled", "connecting", "handshaking", "joining", "reconciling", "live", "degraded", "reconnecting", "error"] },
            "source": { "type": "string", "maxLength": 120 },
            "event": { "type": "string", "maxLength": 200 },
            "quality": { "enum": ["fresh", "degraded", "stale", "unknown"] },
            "raceStatus": {
              "anyOf": [
                { "enum": ["scheduled", "staging", "running", "complete", "cancelled", "not_run", "unknown"] },
                { "type": "null" }
              ]
            },
            "message": { "type": "string", "maxLength": 500 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "severity"],
          "properties": {
            "code": { "type": "string", "pattern": "^[a-z0-9_.-]+$", "maxLength": 80 },
            "message": { "type": "string", "minLength": 1, "maxLength": 500 },
            "severity": { "enum": ["info", "warning", "error"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason"],
          "properties": {
            "reason": { "enum": ["epoch_changed", "history_gap", "event_changed", "bootstrap"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "maxProperties": 0
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["announcementId", "clearedAt"],
          "properties": {
            "announcementId": { "type": "string", "minLength": 1, "maxLength": 128 },
            "clearedAt": { "type": "string", "format": "date-time" }
          }
        },
        {
          "$ref": "announcement.schema.json"
        }
      ]
    }
  }
}
