{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpv.example.invalid/contracts/race-event/v1/history-response.schema.json",
  "title": "Race Event Announcement History v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "eventSessionId", "items", "nextCursor"],
  "properties": {
    "format": { "const": "org.fpv.race-event.announcement-history" },
    "version": { "const": 1 },
    "eventSessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "items": {
      "type": "array",
      "items": { "$ref": "announcement.schema.json" }
    },
    "nextCursor": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    }
  }
}
